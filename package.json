{
  "name": "han-font-manager",
  "version": "3.0.0",
  "description": "字体管理器",
  "main": "./out/main/index.js",
  "author": "Xie Ele",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node build/rust/build-core-worker.cjs --optional && node node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "npm run verify && node build/rust/build-core-worker.cjs --required && node build/security/sync-public-keys.cjs && node node_modules/electron-vite/bin/electron-vite.js build && node build/obfuscate-dist.cjs",
    "build:win": "npm run verify && node build/rust/build-core-worker.cjs --required && node build/security/sync-public-keys.cjs && node node_modules/electron-vite/bin/electron-vite.js build && node build/obfuscate-dist.cjs && node node_modules/electron-builder/out/cli/cli.js --win --config electron-builder.yml",
    "preview": "node node_modules/electron-vite/bin/electron-vite.js preview",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "verify": "npm run typecheck && npm run diagnostics:all",
    "dev:debug": "node build/rust/build-core-worker.cjs --optional && node node_modules/electron-vite/bin/electron-vite.js dev --debug",
    "smooth": "npm run verify && node build/rust/build-core-worker.cjs --optional && node build/security/sync-public-keys.cjs && node node_modules/electron-vite/bin/electron-vite.js build && node build/obfuscate-dist.cjs && node node_modules/electron-vite/bin/electron-vite.js preview",
    "start": "node node_modules/electron-vite/bin/electron-vite.js preview",
    "pack:dir": "npm run verify && node build/rust/build-core-worker.cjs --required && node build/security/sync-public-keys.cjs && node node_modules/electron-vite/bin/electron-vite.js build && node build/obfuscate-dist.cjs && node node_modules/electron-builder/out/cli/cli.js --dir --config electron-builder.yml",
    "rebuild:native": "node node_modules/electron-builder/out/cli/cli.js install-app-deps",
    "license:create": "node build/security/create-license.cjs",
    "security:sync-keys": "node build/security/sync-public-keys.cjs",
    "rust:build": "node build/rust/build-core-worker.cjs --required",
    "rust:build:optional": "node build/rust/build-core-worker.cjs --optional",
    "diagnostics:tag-consistency": "node build/diagnostics/check-tag-consistency.cjs",
    "diagnostics:query-protocol": "node build/diagnostics/check-query-protocol.cjs",
    "diagnostics:state-fallback": "node build/diagnostics/check-state-fallback-policy.cjs",
    "diagnostics:rust-state-fallback": "node build/diagnostics/check-rust-state-fallback-failure-protocol.cjs",
    "diagnostics:scan-fallback": "node build/diagnostics/check-scan-fallback-policy.cjs",
    "diagnostics:final-migration": "node build/diagnostics/check-final-migration-closure.cjs",
    "diagnostics:preview-cache-root": "node build/diagnostics/check-preview-cache-unavailable-root.cjs",
    "diagnostics:io-deadline": "node build/diagnostics/check-io-deadline-policy.cjs",
    "diagnostics:preview-scheduler": "node build/diagnostics/check-preview-request-scheduler.cjs",
    "diagnostics:startup-nas-deadline": "node build/diagnostics/check-startup-nas-deadline-policy.cjs",
    "diagnostics:folder-cache-availability": "node build/diagnostics/check-folder-cache-availability.cjs",
    "diagnostics:library-db-handle": "node build/diagnostics/check-library-db-handle-lifecycle.cjs",
    "diagnostics:grid-preview-size": "node build/diagnostics/check-grid-preview-size-policy.cjs",
    "diagnostics:grid-preview-clip-safe": "node build/diagnostics/check-grid-preview-clip-safe.cjs",
    "diagnostics:grid-preview-visual-fit": "node build/diagnostics/check-grid-preview-visual-fit.cjs",
    "diagnostics:preview-render-concurrency": "node build/diagnostics/check-preview-render-concurrency.cjs",
    "diagnostics:preview-cache-tier": "node build/diagnostics/check-preview-cache-tier.cjs",
    "diagnostics:preview-cache-hydration": "node build/diagnostics/check-preview-cache-hydration.cjs",
    "diagnostics:preview-cache-publish": "node build/diagnostics/check-preview-cache-publish.cjs",
    "diagnostics:shared-cache-atomic-write": "node build/diagnostics/check-shared-cache-atomic-write.cjs",
    "diagnostics:preview-cache-prefetch": "node build/diagnostics/check-preview-cache-prefetch.cjs",
    "diagnostics:shared-cache-circuit-breaker": "node build/diagnostics/check-shared-cache-circuit-breaker.cjs",
    "diagnostics:preview-local-cache-eviction": "node build/diagnostics/check-preview-local-cache-eviction.cjs",
    "diagnostics:preview-cache-generation": "node build/diagnostics/check-preview-cache-generation.cjs",
    "diagnostics:preview-cache-shared-presence": "node build/diagnostics/check-preview-cache-shared-presence.cjs",
    "diagnostics:preview-cache-presence-index": "node build/diagnostics/check-preview-cache-presence-index.cjs",
    "diagnostics:preview-cache-meta": "node build/diagnostics/check-preview-cache-meta.cjs",
    "diagnostics:nas-cache": "node build/diagnostics/check-nas-cache-summary.cjs",
    "diagnostics:preview-cache-manifest": "node build/diagnostics/check-preview-cache-manifest.cjs",
    "diagnostics:preview-cache-key-policy": "node build/diagnostics/check-preview-cache-key-policy.cjs",
    "diagnostics:shared-metadata-field-merge": "node build/diagnostics/check-shared-metadata-field-merge.cjs",
    "diagnostics:shared-tag-ops-replay": "node build/diagnostics/check-shared-tag-ops-replay.cjs",
    "diagnostics:shared-lease-lock": "node build/diagnostics/check-shared-lease-lock.cjs",
    "diagnostics:shared-tag-conflicts": "node build/diagnostics/check-shared-tag-conflicts.cjs",
    "diagnostics:shared-metadata-migration": "node build/diagnostics/check-shared-metadata-migration.cjs",
    "diagnostics:shared-index-snapshot": "node build/diagnostics/check-shared-index-snapshot-latest.cjs",
    "diagnostics:shared-index-maintenance": "node build/diagnostics/check-shared-index-maintenance.cjs",
    "diagnostics:shared-metadata-repair": "node build/diagnostics/check-shared-metadata-repair.cjs",
    "maintenance:repair-shared-metadata": "node build/maintenance/repair-shared-metadata.cjs",
    "diagnostics:shared-index-auto-maintenance": "node build/diagnostics/check-shared-index-auto-maintenance.cjs",
    "diagnostics:shared-metadata-frontend": "node build/diagnostics/check-shared-metadata-frontend-diagnostics.cjs",
    "diagnostics:shared-tag-ops-archive": "node build/diagnostics/check-shared-tag-ops-archive.cjs",
    "diagnostics:destructive-batch-lease-lock": "node build/diagnostics/check-destructive-batch-lease-lock.cjs",
    "diagnostics:lease-lock-frontend-notice": "node build/diagnostics/check-lease-lock-frontend-notice.cjs",
    "diagnostics:shared-index-frontend-maintenance": "node build/diagnostics/check-shared-index-frontend-maintenance.cjs",
    "diagnostics:sidebar-tab-layout": "node build/diagnostics/check-sidebar-tab-layout.cjs",
    "diagnostics:performance-log-policy": "node build/diagnostics/check-performance-log-policy.cjs",
    "diagnostics:library-persistence-order": "node build/diagnostics/check-library-persistence-order.cjs",
    "diagnostics:scan-root-path-boundary": "node build/diagnostics/check-scan-root-path-boundary.cjs",
    "diagnostics:release-build-gate": "node build/diagnostics/check-release-build-gate.cjs",
    "diagnostics:window-close-flush": "node build/diagnostics/check-window-close-flush.cjs",
    "diagnostics:window-corner-clipping": "node build/diagnostics/check-frameless-window-corner-clipping.cjs",
    "diagnostics:orchestration-contracts": "node build/diagnostics/check-orchestration-contracts.cjs",
    "diagnostics:font-path-policy": "node build/diagnostics/check-font-path-authorization.cjs --case=POLICY",
    "diagnostics:font-read-authorization": "node build/diagnostics/check-font-path-authorization.cjs --case=READ",
    "diagnostics:font-resource-session-result": "node build/diagnostics/check-font-activation-transaction.cjs --case=A1",
    "diagnostics:font-deactivation-batch-settlement": "node build/diagnostics/check-font-activation-transaction.cjs --case=A2",
    "diagnostics:font-activation-compensation": "node build/diagnostics/check-font-activation-transaction.cjs --case=A3-A7",
    "diagnostics:font-activation-batch-transaction": "node build/diagnostics/check-font-activation-transaction.cjs --case=A8",
    "diagnostics:all": "node build/diagnostics/run-all.cjs",
    "diagnostics:font-write-queue-durability": "node build/diagnostics/check-font-write-queue-durability.cjs",
    "diagnostics:activation-save-queue-durability": "node build/diagnostics/check-activation-save-queue-durability.cjs",
    "diagnostics:physical-mutation-index": "node build/diagnostics/check-physical-mutation-index-reconciliation.cjs",
    "diagnostics:merged-index-mutation": "node build/diagnostics/check-merged-index-mutation-serialization.cjs",
    "diagnostics:query-cache-generation": "node build/diagnostics/check-query-cache-invalidation-generation.cjs",
    "diagnostics:scan-lifecycle-durability": "node build/diagnostics/check-scan-lifecycle-durability.cjs",
    "diagnostics:rust-scheduler-cache-generation": "node build/diagnostics/check-rust-scheduler-cache-generation.cjs",
    "diagnostics:inflight-cache-lifecycle": "node build/diagnostics/check-inflight-cache-lifecycle.cjs",
    "diagnostics:shutdown-log-durability": "node build/diagnostics/check-shutdown-log-durability.cjs",
    "diagnostics:database-maintenance-serialization": "node build/diagnostics/check-database-maintenance-serialization.cjs",
    "diagnostics:folder-count-path-consistency": "node build/diagnostics/check-folder-count-path-consistency.cjs",
    "diagnostics:log-regression-hardening": "node build/diagnostics/check-log-regression-hardening.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "fontkit": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "copyright": "Copyright © 2026 Xie Ele"
}
